{
  "entities": {
    "StudyNote": {
      "title": "StudyNote",
      "description": "A scholarly study note, Kitab Ibarat explanation, translation, or Da'wa outline saved by a student.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The authenticated Firebase user UID who owns this study note.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "description": "The ICS Academy student identifier (e.g., st-101).",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mode": {
          "type": "string",
          "description": "The AI research mode used to generate the note.",
          "enum": ["kitab", "qa", "translation", "dawa"],
          "minLength": 2,
          "maxLength": 20
        },
        "language": {
          "type": "string",
          "description": "The primary output language of the note.",
          "enum": ["ml", "en", "ar", "ur", "es", "de"],
          "minLength": 2,
          "maxLength": 5
        },
        "prompt": {
          "type": "string",
          "description": "The student's question or Kitab passage.",
          "minLength": 1,
          "maxLength": 2000
        },
        "response": {
          "type": "string",
          "description": "The AI-generated scholarly explanation or study outline.",
          "minLength": 1,
          "maxLength": 15000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The server timestamp when the note was created."
        }
      },
      "required": ["uid", "studentId", "mode", "language", "prompt", "response", "createdAt"]
    },
    "LeaveRecord": {
      "title": "LeaveRecord",
      "description": "A student leave registration or return registry entry stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The authenticated Firebase user UID who submitted the record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "description": "The ICS Academy student identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "The full name of the student.",
          "minLength": 1,
          "maxLength": 120
        },
        "admissionNo": {
          "type": "string",
          "description": "The student's admission number.",
          "minLength": 1,
          "maxLength": 40
        },
        "recordType": {
          "type": "string",
          "description": "Whether this entry is a leave application or return registration.",
          "enum": ["application", "return"],
          "minLength": 6,
          "maxLength": 15
        },
        "dateString": {
          "type": "string",
          "description": "Formatted date of departure or return (e.g., 29 Oct 2026).",
          "minLength": 4,
          "maxLength": 40
        },
        "timeString": {
          "type": "string",
          "description": "Formatted 12-hour time of departure or return (e.g., 09:00 AM).",
          "minLength": 4,
          "maxLength": 20
        },
        "reason": {
          "type": "string",
          "description": "The selected reason for leave or return note.",
          "minLength": 1,
          "maxLength": 120
        },
        "details": {
          "type": "string",
          "description": "Additional details when reason is Other.",
          "minLength": 0,
          "maxLength": 6000
        },
        "status": {
          "type": "string",
          "description": "Current approval or registration status.",
          "enum": ["pending", "recorded"],
          "minLength": 6,
          "maxLength": 15
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The server timestamp when the record was submitted."
        }
      },
      "required": [
        "uid",
        "studentId",
        "studentName",
        "admissionNo",
        "recordType",
        "dateString",
        "timeString",
        "reason",
        "details",
        "status",
        "createdAt"
      ]
    },
    "DigitalKitab": {
      "title": "DigitalKitab",
      "description": "An academic Kitab or scholarly PDF stored in Firebase Storage and indexed in the Student Dashboard Digital Library.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The authenticated user or student portal session UID that registered or synced the Kitab.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "description": "The ICS Academy student identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "The transliterated or English title of the academic Kitab.",
          "minLength": 1,
          "maxLength": 160
        },
        "arabicTitle": {
          "type": "string",
          "description": "The original Arabic title of the Kitab.",
          "minLength": 0,
          "maxLength": 160
        },
        "author": {
          "type": "string",
          "description": "The classical or contemporary scholar who authored the Kitab.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "The academic subject category of the Kitab.",
          "enum": ["fiqh", "hadith", "tafsir", "aqeedah", "nahw", "history"],
          "minLength": 4,
          "maxLength": 15
        },
        "classBatch": {
          "type": "string",
          "description": "Target Da'wa College class or batch (e.g., S1 Da'wa, S2 Da'wa, S3 Da'wa, General Reference).",
          "minLength": 2,
          "maxLength": 40
        },
        "language": {
          "type": "string",
          "description": "Primary language(s) of the PDF edition.",
          "minLength": 2,
          "maxLength": 40
        },
        "pages": {
          "type": "integer",
          "description": "Total page count of the PDF volume.",
          "minimum": 1,
          "maximum": 5000
        },
        "storagePath": {
          "type": "string",
          "description": "Firebase Storage object path (e.g., kitabs/fiqh/fathul-mueen.pdf).",
          "minLength": 4,
          "maxLength": 240,
          "pattern": "^kitabs/[a-zA-Z0-9_\\-/\\.]+\\.pdf$"
        },
        "pdfUrl": {
          "type": "string",
          "description": "Resolved Firebase Storage download URL or fallback URL for the PDF.",
          "minLength": 0,
          "maxLength": 1500
        },
        "summary": {
          "type": "string",
          "description": "Concise syllabus description and scholarly overview of the Kitab.",
          "minLength": 1,
          "maxLength": 1200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the Kitab entry was indexed."
        }
      },
      "required": [
        "uid",
        "studentId",
        "title",
        "arabicTitle",
        "author",
        "category",
        "classBatch",
        "language",
        "pages",
        "storagePath",
        "pdfUrl",
        "summary",
        "createdAt"
      ]
    },
    "CampusChatMessage": {
      "title": "CampusChatMessage",
      "description": "A real-time message in ICS Academy Campus Messenger supporting direct chats, batch groups, Staff Room, delivery ticks, and read receipts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campusId": {
          "type": "string",
          "description": "Fixed campus tenant identifier (ics-academy).",
          "enum": ["ics-academy"],
          "minLength": 11,
          "maxLength": 16
        },
        "roomId": {
          "type": "string",
          "description": "Target room identifier (direct__, batch_group__, or staff_group__usthads).",
          "minLength": 3,
          "maxLength": 160
        },
        "senderId": {
          "type": "string",
          "description": "Canonical actor ID of the sender (std-..., usthad-..., principal-...).",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 1,
          "maxLength": 120
        },
        "senderRole": {
          "type": "string",
          "description": "Role of the sender.",
          "enum": ["student", "usthad", "principal"],
          "minLength": 6,
          "maxLength": 12
        },
        "senderBadge": {
          "type": "string",
          "description": "Optional role or class badge.",
          "minLength": 0,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "description": "Message body or caption.",
          "minLength": 0,
          "maxLength": 8000
        },
        "mediaType": {
          "type": "string",
          "description": "Attached media category.",
          "enum": ["none", "voice", "image", "pdf", "call"],
          "minLength": 3,
          "maxLength": 10
        },
        "callMeta": {
          "type": "object",
          "description": "Optional structured metadata for in-chat Voice/Video call log cards (callId, callType, callStatus, durationSec, callerId, calleeId)."
        },
        "mediaUrl": {
          "type": "string",
          "description": "Optional bounded data URL or HTTPS link for attached media.",
          "minLength": 0,
          "maxLength": 750000
        },
        "mediaName": {
          "type": "string",
          "description": "Optional attachment filename.",
          "minLength": 0,
          "maxLength": 200
        },
        "mediaSizeLabel": {
          "type": "string",
          "description": "Optional formatted attachment size.",
          "minLength": 0,
          "maxLength": 64
        },
        "mediaDurationSec": {
          "type": "number",
          "description": "Optional duration in seconds for voice notes.",
          "minimum": 0,
          "maximum": 3600
        },
        "imageQuality": {
          "type": "string",
          "description": "Optional image quality tier.",
          "enum": ["standard", "hd"],
          "minLength": 2,
          "maxLength": 10
        },
        "imageDimensions": {
          "type": "string",
          "description": "Optional image pixel dimensions string.",
          "minLength": 0,
          "maxLength": 40
        },
        "replyTo": {
          "type": "object",
          "description": "Optional reference to a replied message."
        },
        "reactions": {
          "type": "object",
          "description": "Emoji reactions map keyed by emoji string."
        },
        "deliveredTo": {
          "type": "array",
          "description": "Bounded list of actor IDs that received the message."
        },
        "deliveredAtMap": {
          "type": "object",
          "description": "Optional bounded map of actor ID to epoch ms timestamp when the message was delivered."
        },
        "readBy": {
          "type": "array",
          "description": "Bounded list of actor IDs that read the message."
        },
        "readAtMap": {
          "type": "object",
          "description": "Optional bounded map of actor ID to epoch ms timestamp when the message was read."
        },
        "starredBy": {
          "type": "array",
          "description": "Optional bounded list of actor IDs who starred this message."
        },
        "isForwarded": {
          "type": "boolean",
          "description": "Optional flag indicating this message was forwarded from another chat."
        },
        "deletedFor": {
          "type": "array",
          "description": "Bounded list of actor IDs who deleted this message for themselves."
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Whether the message was deleted for everyone."
        },
        "deletedBy": {
          "type": "string",
          "description": "Display name of the actor who deleted the message for everyone.",
          "minLength": 0,
          "maxLength": 120
        },
        "deletedById": {
          "type": "string",
          "description": "Actor ID of the deleter.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the message was created."
        },
        "createdAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds timestamp for deterministic sorting.",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "campusId",
        "roomId",
        "senderId",
        "senderName",
        "senderRole",
        "text",
        "mediaType",
        "reactions",
        "deliveredTo",
        "readBy",
        "deletedFor",
        "isDeleted",
        "createdAt",
        "createdAtMs"
      ]
    },
    "CampusChatRoomMeta": {
      "title": "CampusChatRoomMeta",
      "description": "Room moderation metadata such as pinned message ID and Usthad-only lock state.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "description": "Fixed campus tenant identifier (ics-academy).",
          "enum": ["ics-academy"],
          "minLength": 11,
          "maxLength": 16
        },
        "roomId": {
          "type": "string",
          "description": "Canonical room identifier.",
          "minLength": 3,
          "maxLength": 160
        },
        "onlyAdminsCanPost": {
          "type": "boolean",
          "description": "Whether messaging is restricted to Usthads and Principal."
        },
        "pinnedMessageId": {
          "type": "string",
          "description": "Optional pinned message identifier or null.",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByActorId": {
          "type": "string",
          "description": "Actor ID who last updated the room metadata.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when metadata was created."
        },
        "updatedAtMs": {
          "type": "integer",
          "description": "Last update epoch milliseconds.",
          "minimum": 1
        }
      },
      "required": [
        "campusId",
        "roomId",
        "onlyAdminsCanPost",
        "pinnedMessageId",
        "updatedByActorId",
        "createdAt",
        "updatedAtMs"
      ]
    },
    "CampusChatPresence": {
      "title": "CampusChatPresence",
      "description": "Live online status, last seen timestamp, and typing/recording indicator for an ICS Academy portal actor.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "description": "Fixed campus tenant identifier (ics-academy).",
          "enum": ["ics-academy"],
          "minLength": 11,
          "maxLength": 16
        },
        "actorId": {
          "type": "string",
          "description": "Canonical portal actor ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "description": "Display name of the actor.",
          "minLength": 1,
          "maxLength": 120
        },
        "actorRole": {
          "type": "string",
          "description": "Role of the actor.",
          "enum": ["student", "usthad", "principal"],
          "minLength": 6,
          "maxLength": 12
        },
        "lastSeenMs": {
          "type": "integer",
          "description": "Last heartbeat epoch milliseconds.",
          "minimum": 1
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether the actor is currently active in the app."
        },
        "hideOnline": {
          "type": "boolean",
          "description": "Whether the user opted to hide online status."
        },
        "typingRoomId": {
          "type": "string",
          "description": "Room ID where the user is currently typing or recording.",
          "minLength": 0,
          "maxLength": 160
        },
        "typingMode": {
          "type": "string",
          "description": "Current composer activity state.",
          "enum": ["idle", "typing", "recording"],
          "minLength": 4,
          "maxLength": 12
        },
        "typingUpdatedAtMs": {
          "type": "integer",
          "description": "Timestamp of last typing state update.",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when presence doc was initialized."
        }
      },
      "required": [
        "campusId",
        "actorId",
        "actorName",
        "actorRole",
        "lastSeenMs",
        "isOnline",
        "hideOnline",
        "typingRoomId",
        "typingMode",
        "typingUpdatedAtMs",
        "createdAt"
      ]
    },
    "CampusNotification": {
      "title": "CampusNotification",
      "description": "Real-time targeted notification event for notices, chat messages, attendance, or leave updates.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification ID.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campusId": {
          "type": "string",
          "description": "Fixed campus tenant identifier (ics-academy).",
          "enum": ["ics-academy"],
          "minLength": 11,
          "maxLength": 16
        },
        "type": {
          "type": "string",
          "description": "Notification category.",
          "enum": ["notice", "attendance", "period-attendance", "leave", "chat"],
          "minLength": 4,
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "description": "Notification title.",
          "minLength": 1,
          "maxLength": 240
        },
        "message": {
          "type": "string",
          "description": "Notification preview body.",
          "minLength": 1,
          "maxLength": 1500
        },
        "category": {
          "type": "string",
          "description": "Optional notice category.",
          "minLength": 0,
          "maxLength": 40
        },
        "targetClass": {
          "type": "string",
          "description": "Optional single target class.",
          "minLength": 0,
          "maxLength": 40
        },
        "targetClasses": {
          "type": "array",
          "description": "Optional bounded list of target classes."
        },
        "targetStudentId": {
          "type": "string",
          "description": "Optional targeted student ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "targetRecipientId": {
          "type": "string",
          "description": "Optional direct recipient actor ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "targetStaffOnly": {
          "type": "boolean",
          "description": "Whether notification is restricted to Usthads and Principal."
        },
        "actorId": {
          "type": "string",
          "description": "Sender actor ID for self-exclusion.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "description": "Sender display name.",
          "minLength": 0,
          "maxLength": 120
        },
        "href": {
          "type": "string",
          "description": "Target hash route.",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when notification was created."
        },
        "createdAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds timestamp.",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "campusId",
        "type",
        "title",
        "message",
        "href",
        "createdAt",
        "createdAtMs"
      ]
    },
    "CampusAcademicRecord": {
      "title": "CampusAcademicRecord",
      "description": "Unified real-time academic and institutional record for Monthly/Unit Tests, Student Test Submissions, Holiday Academic & SSF Da'wa/Ziyarat Logs, Private Student Discipline Notes, and Zadul Khair Monthly Household Contributions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique record identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campusId": {
          "type": "string",
          "description": "Fixed campus tenant identifier (ics-academy).",
          "enum": ["ics-academy"],
          "minLength": 11,
          "maxLength": 16
        },
        "recordKind": {
          "type": "string",
          "description": "Category of campus record.",
          "enum": [
            "unit_test",
            "test_submission",
            "holiday_log",
            "discipline_note",
            "zadul_khair",
            "monthly_syllabus"
          ],
          "minLength": 8,
          "maxLength": 24
        },
        "className": {
          "type": "string",
          "description": "Target class or batch name.",
          "minLength": 1,
          "maxLength": 40
        },
        "actorId": {
          "type": "string",
          "description": "Canonical portal actor ID who created or last updated the record.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "description": "Display name of the actor.",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "description": "Current workflow or payment status of the record.",
          "enum": [
            "active",
            "submitted",
            "graded",
            "pending",
            "verified",
            "advisory",
            "warning",
            "serious",
            "paid",
            "partial",
            "unpaid",
            "deleted"
          ],
          "minLength": 4,
          "maxLength": 24
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Whether the record has been soft-deleted."
        },
        "studentId": {
          "type": "string",
          "description": "Optional associated student portal ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Optional associated student full name.",
          "minLength": 0,
          "maxLength": 120
        },
        "admissionNo": {
          "type": "string",
          "description": "Optional student admission number.",
          "minLength": 0,
          "maxLength": 40
        },
        "month": {
          "type": "string",
          "description": "Optional month label (e.g., November 2026).",
          "minLength": 0,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "description": "Optional title of test, holiday activity, or discipline note.",
          "minLength": 0,
          "maxLength": 240
        },
        "subjectOrCategory": {
          "type": "string",
          "description": "Optional subject name, testId reference, holiday category, or discipline category.",
          "minLength": 0,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Optional detailed body, reflection note, or violation details.",
          "minLength": 0,
          "maxLength": 5000
        },
        "remarks": {
          "type": "string",
          "description": "Optional Usthad remarks, corrective guidance, or payment note.",
          "minLength": 0,
          "maxLength": 2000
        },
        "dateString": {
          "type": "string",
          "description": "Optional formatted date string.",
          "minLength": 0,
          "maxLength": 40
        },
        "receiptNo": {
          "type": "string",
          "description": "Optional Zadul Khair receipt number or reference ID.",
          "minLength": 0,
          "maxLength": 60
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional compressed photo proof data URL.",
          "minLength": 0,
          "maxLength": 700000
        },
        "totalMarks": {
          "type": "number",
          "description": "Optional maximum marks for a test or submission.",
          "minimum": 0,
          "maximum": 1000
        },
        "obtainedMarks": {
          "type": "number",
          "description": "Optional marks scored by the student.",
          "minimum": 0,
          "maximum": 1000
        },
        "fixedAmount": {
          "type": "number",
          "description": "Optional monthly fixed household contribution amount in INR.",
          "minimum": 0,
          "maximum": 1000000
        },
        "paidAmount": {
          "type": "number",
          "description": "Optional paid household contribution amount in INR.",
          "minimum": 0,
          "maximum": 1000000
        },
        "acknowledged": {
          "type": "boolean",
          "description": "Optional student acknowledgement flag for discipline advisory."
        },
        "questions": {
          "type": "array",
          "description": "Optional bounded list of MCQ and Objective question objects."
        },
        "answers": {
          "type": "object",
          "description": "Optional map of questionId to student's selected/typed answer."
        },
        "questionMarks": {
          "type": "object",
          "description": "Optional map of questionId to awarded marks."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the record was created."
        },
        "updatedAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds of creation or last update.",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "campusId",
        "recordKind",
        "className",
        "actorId",
        "actorName",
        "status",
        "isDeleted",
        "createdAt",
        "updatedAtMs"
      ]
    },
    "CampusCall": {
      "title": "CampusCall",
      "description": "A real-time 1-on-1 WebRTC voice or video call signaling session and persistent call log record in ICS Academy Campus Messenger.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique call session identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campusId": {
          "type": "string",
          "description": "Fixed campus tenant identifier (ics-academy).",
          "enum": ["ics-academy"],
          "minLength": 11,
          "maxLength": 16
        },
        "roomId": {
          "type": "string",
          "description": "Canonical 1-on-1 direct room identifier (direct__actorA__actorB).",
          "minLength": 3,
          "maxLength": 160
        },
        "callType": {
          "type": "string",
          "description": "Whether this call is a voice-only or video call.",
          "enum": ["voice", "video"],
          "minLength": 5,
          "maxLength": 5
        },
        "callerId": {
          "type": "string",
          "description": "Canonical portal actor ID of the caller.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "callerName": {
          "type": "string",
          "description": "Display name of the caller.",
          "minLength": 1,
          "maxLength": 120
        },
        "callerRole": {
          "type": "string",
          "description": "Portal role of the caller.",
          "enum": ["student", "usthad", "principal"],
          "minLength": 6,
          "maxLength": 12
        },
        "callerSubtitle": {
          "type": "string",
          "description": "Optional class or designation subtitle of the caller.",
          "minLength": 0,
          "maxLength": 120
        },
        "calleeId": {
          "type": "string",
          "description": "Canonical portal actor ID of the callee.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^(st[d]?|usthad|principal)-[a-zA-Z0-9_\\-]+$"
        },
        "calleeName": {
          "type": "string",
          "description": "Display name of the callee.",
          "minLength": 1,
          "maxLength": 120
        },
        "calleeRole": {
          "type": "string",
          "description": "Portal role of the callee.",
          "enum": ["student", "usthad", "principal"],
          "minLength": 6,
          "maxLength": 12
        },
        "calleeSubtitle": {
          "type": "string",
          "description": "Optional class or designation subtitle of the callee.",
          "minLength": 0,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "description": "Current lifecycle state of the call.",
          "enum": ["ringing", "accepted", "connected", "declined", "missed", "ended", "busy"],
          "minLength": 4,
          "maxLength": 12
        },
        "offerSdp": {
          "type": "string",
          "description": "WebRTC SDP offer JSON payload from the caller.",
          "minLength": 0,
          "maxLength": 24000
        },
        "answerSdp": {
          "type": "string",
          "description": "Optional WebRTC SDP answer JSON payload from the callee.",
          "minLength": 0,
          "maxLength": 24000
        },
        "callerCandidates": {
          "type": "array",
          "description": "Bounded list of serialized WebRTC ICE candidates emitted by the caller."
        },
        "calleeCandidates": {
          "type": "array",
          "description": "Bounded list of serialized WebRTC ICE candidates emitted by the callee."
        },
        "startedAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds when the call was initiated.",
          "minimum": 1
        },
        "connectedAtMs": {
          "type": "integer",
          "description": "Optional epoch milliseconds when media connected.",
          "minimum": 0
        },
        "endedAtMs": {
          "type": "integer",
          "description": "Optional epoch milliseconds when the call ended.",
          "minimum": 0
        },
        "durationSec": {
          "type": "number",
          "description": "Optional call duration in seconds.",
          "minimum": 0,
          "maximum": 86400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the call document was created."
        },
        "updatedAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds of the last signaling state update.",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "campusId",
        "roomId",
        "callType",
        "callerId",
        "callerName",
        "callerRole",
        "calleeId",
        "calleeName",
        "calleeRole",
        "status",
        "offerSdp",
        "callerCandidates",
        "calleeCandidates",
        "startedAtMs",
        "createdAt",
        "updatedAtMs"
      ]
    }
  },
  "firestore": {
    "/studyNotes/{noteId}": {
      "schema": { "$ref": "#/entities/StudyNote" },
      "description": "Stores scholarly AI study notes and Kitab research saved by students."
    },
    "/leaveRecords/{recordId}": {
      "schema": { "$ref": "#/entities/LeaveRecord" },
      "description": "Stores student leave applications and campus return registry records."
    },
    "/digitalKitabs/{kitabId}": {
      "schema": { "$ref": "#/entities/DigitalKitab" },
      "description": "Stores metadata and Firebase Storage paths for academic Kitabs and PDFs in the Digital Library."
    },
    "/campusChatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/CampusChatMessage" },
      "description": "Stores real-time Campus Messenger messages, call log cards, delivery receipts, and read receipts synced across web, iOS PWA, and Android APK."
    },
    "/campusChatMeta/{roomDocId}": {
