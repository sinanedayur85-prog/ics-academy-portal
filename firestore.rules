rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot Connection Check Path
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isPortalStudentSession(uid, studentId) {
      return studentId is string
        && studentId.size() >= 4
        && studentId.size() <= 32
        && studentId.matches('^st[d]?-[a-zA-Z0-9_\\-]+$')
        && uid is string
        && uid.size() >= 11
        && uid.size() <= 64
        && uid == ('portal_' + studentId);
    }

    function isAuthorizedStudent(uid, studentId) {
      return (isVerifiedUser() && uid == request.auth.uid)
        || isPortalStudentSession(uid, studentId);
    }

    function isPortalActorId(actorId) {
      return actorId is string
        && actorId.size() >= 4
        && actorId.size() <= 64
        && (
          actorId.matches('^st[d]?-[a-zA-Z0-9_\\-]+$')
          || actorId.matches('^usthad-[a-zA-Z0-9_\\-]+$')
          || actorId.matches('^principal-[a-zA-Z0-9_\\-]+$')
        );
    }

    // Validation Blueprint: StudyNote
    function isValidStudyNote(data) {
      return data.keys().hasAll(['uid', 'studentId', 'mode', 'language', 'prompt', 'response', 'createdAt'])
        && data.keys().hasOnly(['uid', 'studentId', 'mode', 'language', 'prompt', 'response', 'createdAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.studentId is string
        && data.studentId.size() >= 1
        && data.studentId.size() <= 64
        && data.studentId.matches('^[a-zA-Z0-9_\\-]+$')
        && isAuthorizedStudent(data.uid, data.studentId)
        && data.mode is string
        && data.mode.size() >= 2
        && data.mode.size() <= 20
        && (data.mode == 'kitab' || data.mode == 'qa' || data.mode == 'translation' || data.mode == 'dawa')
        && data.language is string
        && data.language.size() >= 2
        && data.language.size() <= 5
        && (data.language == 'ml' || data.language == 'en' || data.language == 'ar' || data.language == 'ur' || data.language == 'es' || data.language == 'de')
        && data.prompt is string
        && data.prompt.size() >= 1
        && data.prompt.size() <= 2000
        && data.response is string
        && data.response.size() >= 1
        && data.response.size() <= 15000
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: LeaveRecord
    function isValidLeaveRecord(data) {
      return data.keys().hasAll([
          'uid',
          'studentId',
          'studentName',
          'admissionNo',
          'recordType',
          'dateString',
          'timeString',
          'reason',
          'details',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'studentId',
          'studentName',
          'admissionNo',
          'recordType',
          'dateString',
          'timeString',
          'reason',
          'details',
          'status',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.studentId is string
        && data.studentId.size() >= 1
        && data.studentId.size() <= 64
        && data.studentId.matches('^[a-zA-Z0-9_\\-]+$')
        && isAuthorizedStudent(data.uid, data.studentId)
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 120
        && data.admissionNo is string
        && data.admissionNo.size() >= 1
        && data.admissionNo.size() <= 40
        && data.recordType is string
        && data.recordType.size() >= 6
        && data.recordType.size() <= 15
        && (data.recordType == 'application' || data.recordType == 'return')
        && data.dateString is string
        && data.dateString.size() >= 4
        && data.dateString.size() <= 40
        && data.timeString is string
        && data.timeString.size() >= 4
        && data.timeString.size() <= 20
        && data.reason is string
        && data.reason.size() >= 1
        && data.reason.size() <= 120
        && data.details is string
        && data.details.size() <= 6000
        && data.status is string
        && data.status.size() >= 6
        && data.status.size() <= 15
        && (data.status == 'pending' || data.status == 'recorded')
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: DigitalKitab
    function isValidDigitalKitab(data) {
      return data.keys().hasAll([
          'uid',
          'studentId',
          'title',
          'arabicTitle',
          'author',
          'category',
          'classBatch',
          'language',
          'pages',
          'storagePath',
          'pdfUrl',
          'summary',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'studentId',
          'title',
          'arabicTitle',
          'author',
          'category',
          'classBatch',
          'language',
          'pages',
          'storagePath',
          'pdfUrl',
          'summary',
          'createdAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.studentId is string
        && data.studentId.size() >= 1
        && data.studentId.size() <= 64
        && data.studentId.matches('^[a-zA-Z0-9_\\-]+$')
        && isAuthorizedStudent(data.uid, data.studentId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.arabicTitle is string
        && data.arabicTitle.size() <= 160
        && data.author is string
        && data.author.size() >= 1
        && data.author.size() <= 120
        && data.category is string
        && data.category.size() >= 4
        && data.category.size() <= 15
        && (
          data.category == 'fiqh'
          || data.category == 'hadith'
          || data.category == 'tafsir'
          || data.category == 'aqeedah'
          || data.category == 'nahw'
          || data.category == 'history'
        )
        && data.classBatch is string
        && data.classBatch.size() >= 2
        && data.classBatch.size() <= 40
        && data.language is string
        && data.language.size() >= 2
        && data.language.size() <= 40
        && data.pages is int
        && data.pages >= 1
        && data.pages <= 5000
        && data.storagePath is string
        && data.storagePath.size() >= 4
        && data.storagePath.size() <= 240
        && data.storagePath.matches('^kitabs/[a-zA-Z0-9_\\-/\\.]+\\.pdf$')
        && data.pdfUrl is string
        && data.pdfUrl.size() <= 1500
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 1200
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: CampusChatMessage
    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'id',
          'campusId',
          'roomId',
          'senderId',
          'senderName',
          'senderRole',
          'text',
          'mediaType',
          'reactions',
          'deliveredTo',
          'readBy',
          'deletedFor',
          'isDeleted',
          'createdAt',
          'createdAtMs'
        ])
        && data.keys().hasOnly([
          'id',
          'campusId',
          'roomId',
          'senderId',
          'senderName',
          'senderRole',
          'senderBadge',
          'text',
          'mediaType',
          'callMeta',
          'locationMeta',
          'contactMeta',
          'pollMeta',
          'mediaUrl',
          'mediaName',
          'mediaSizeLabel',
          'mediaDurationSec',
          'imageQuality',
          'imageDimensions',
          'replyTo',
          'reactions',
          'deliveredTo',
          'deliveredAtMap',
          'readBy',
          'readAtMap',
          'starredBy',
          'isForwarded',
          'deletedFor',
          'isDeleted',
          'deletedBy',
          'deletedById',
          'createdAt',
          'createdAtMs'
        ])
        && isValidId(data.id)
        && data.campusId == 'ics-academy'
        && data.roomId is string
        && data.roomId.size() >= 3
        && data.roomId.size() <= 160
        && isPortalActorId(data.senderId)
        && data.senderName is string
        && data.senderName.size() >= 1
        && data.senderName.size() <= 120
        && data.senderRole is string
        && (data.senderRole == 'student' || data.senderRole == 'usthad' || data.senderRole == 'principal')
        && (!('senderBadge' in data) || (data.senderBadge is string && data.senderBadge.size() <= 80))
        && data.text is string
        && data.text.size() <= 8000
        && data.mediaType is string
        && (
          data.mediaType == 'none'
          || data.mediaType == 'voice'
          || data.mediaType == 'image'
          || data.mediaType == 'pdf'
          || data.mediaType == 'call'
          || data.mediaType == 'location'
          || data.mediaType == 'contact'
          || data.mediaType == 'poll'
        )
        && (!('callMeta' in data) || (data.callMeta is map && data.callMeta.size() <= 8))
        && (!('locationMeta' in data) || (data.locationMeta is map && data.locationMeta.size() <= 6))
        && (!('contactMeta' in data) || (data.contactMeta is map && data.contactMeta.size() <= 6))
        && (!('pollMeta' in data) || (data.pollMeta is map && data.pollMeta.size() <= 6))
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 750000))
        && (!('mediaName' in data) || (data.mediaName is string && data.mediaName.size() <= 200))
        && (!('mediaSizeLabel' in data) || (data.mediaSizeLabel is string && data.mediaSizeLabel.size() <= 64))
        && (!('mediaDurationSec' in data) || (data.mediaDurationSec is number && data.mediaDurationSec >= 0 && data.mediaDurationSec <= 3600))
        && (!('imageQuality' in data) || (data.imageQuality is string && (data.imageQuality == 'standard' || data.imageQuality == 'hd')))
        && (!('imageDimensions' in data) || (data.imageDimensions is string && data.imageDimensions.size() <= 40))
        && (!('replyTo' in data) || (data.replyTo is map && data.replyTo.size() <= 4))
        && data.reactions is map
        && data.reactions.size() <= 20
        && data.deliveredTo is list
        && data.deliveredTo.size() >= 1
        && data.deliveredTo.size() <= 300
        && data.deliveredTo[0] is string
        && (!('deliveredAtMap' in data) || (data.deliveredAtMap is map && data.deliveredAtMap.size() <= 300))
        && data.readBy is list
        && data.readBy.size() >= 1
        && data.readBy.size() <= 300
        && data.readBy[0] is string
        && (!('readAtMap' in data) || (data.readAtMap is map && data.readAtMap.size() <= 300))
        && (!('starredBy' in data) || (data.starredBy is list && data.starredBy.size() <= 300 && (data.starredBy.size() == 0 || data.starredBy[0] is string)))
        && (!('isForwarded' in data) || data.isForwarded is bool)
        && data.deletedFor is list
        && data.deletedFor.size() <= 300
        && (data.deletedFor.size() == 0 || data.deletedFor[0] is string)
        && data.isDeleted is bool
        && (!('deletedBy' in data) || (data.deletedBy is string && data.deletedBy.size() <= 120))
        && (!('deletedById' in data) || isPortalActorId(data.deletedById))
        && data.createdAt is timestamp
        && data.createdAtMs is int
        && data.createdAtMs > 0;
    }

    // Validation Blueprint: CampusChatRoomMeta
    function isValidChatRoomMeta(data) {
      return data.keys().hasAll([
          'campusId',
          'roomId',
          'onlyAdminsCanPost',
          'pinnedMessageId',
          'updatedByActorId',
          'createdAt',
          'updatedAtMs'
        ])
        && data.keys().hasOnly([
          'campusId',
          'roomId',
          'onlyAdminsCanPost',
          'pinnedMessageId',
          'updatedByActorId',
          'createdAt',
          'updatedAtMs'
        ])
        && data.campusId == 'ics-academy'
        && data.roomId is string
        && data.roomId.size() >= 3
        && data.roomId.size() <= 160
        && data.onlyAdminsCanPost is bool
        && (data.pinnedMessageId == null || isValidId(data.pinnedMessageId))
        && isPortalActorId(data.updatedByActorId)
        && data.createdAt is timestamp
        && data.updatedAtMs is int
        && data.updatedAtMs > 0;
    }

    // Validation Blueprint: CampusChatPresence
    function isValidChatPresence(data) {
      return data.keys().hasAll([
          'campusId',
          'actorId',
          'actorName',
          'actorRole',
          'lastSeenMs',
          'isOnline',
          'hideOnline',
          'typingRoomId',
          'typingMode',
          'typingUpdatedAtMs',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'campusId',
          'actorId',
          'actorName',
          'actorRole',
          'lastSeenMs',
          'isOnline',
          'hideOnline',
          'typingRoomId',
          'typingMode',
          'typingUpdatedAtMs',
          'createdAt'
        ])
        && data.campusId == 'ics-academy'
        && isPortalActorId(data.actorId)
        && data.actorName is string
        && data.actorName.size() >= 1
        && data.actorName.size() <= 120
        && data.actorRole is string
        && (data.actorRole == 'student' || data.actorRole == 'usthad' || data.actorRole == 'principal')
        && data.lastSeenMs is int
        && data.lastSeenMs > 0
        && data.isOnline is bool
        && data.hideOnline is bool
        && data.typingRoomId is string
        && data.typingRoomId.size() <= 160
        && data.typingMode is string
        && (data.typingMode == 'idle' || data.typingMode == 'typing' || data.typingMode == 'recording')
        && data.typingUpdatedAtMs is int
        && data.typingUpdatedAtMs >= 0
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: CampusNotification
    function isValidCampusNotification(data) {
      return data.keys().hasAll([
          'id',
          'campusId',
          'type',
          'title',
          'message',
          'href',
          'createdAt',
          'createdAtMs'
        ])
        && data.keys().hasOnly([
          'id',
          'campusId',
          'type',
          'title',
          'message',
          'category',
          'targetClass',
          'targetClasses',
          'targetStudentId',
          'targetRecipientId',
          'targetStaffOnly',
          'actorId',
          'actorName',
          'href',
          'createdAt',
          'createdAtMs'
        ])
        && isValidId(data.id)
        && data.campusId == 'ics-academy'
        && data.type is string
        && (
          data.type == 'notice'
          || data.type == 'attendance'
          || data.type == 'period-attendance'
          || data.type == 'leave'
          || data.type == 'chat'
        )
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 240
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 1500
        && (!('category' in data) || (data.category is string && data.category.size() <= 40))
        && (!('targetClass' in data) || (data.targetClass is string && data.targetClass.size() <= 40))
        && (!('targetClasses' in data) || (
          data.targetClasses is list
          && data.targetClasses.size() <= 20
          && (data.targetClasses.size() == 0 || data.targetClasses[0] is string)
        ))
        && (!('targetStudentId' in data) || isPortalActorId(data.targetStudentId))
        && (!('targetRecipientId' in data) || isPortalActorId(data.targetRecipientId))
        && (!('targetStaffOnly' in data) || data.targetStaffOnly is bool)
        && (!('actorId' in data) || isPortalActorId(data.actorId))
        && (!('actorName' in data) || (data.actorName is string && data.actorName.size() <= 120))
        && data.href is string
        && data.href.size() >= 1
        && data.href.size() <= 120
        && data.createdAt is timestamp
        && data.createdAtMs is int
        && data.createdAtMs > 0;
    }

    // Collection: /studyNotes/{noteId}
    match /studyNotes/{noteId} {
      allow get: if isValidId(noteId)
        && resource != null
        && isAuthorizedStudent(existing().uid, existing().studentId);
      allow list: if isAuthorizedStudent(existing().uid, existing().studentId);
      allow create: if isValidId(noteId)
        && isValidStudyNote(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(noteId)
        && resource != null
        && isValidStudyNote(incoming())
        && isAuthorizedStudent(existing().uid, existing().studentId)
        && incoming().uid == existing().uid
        && incoming().studentId == existing().studentId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'response', 'mode', 'language']);
      allow delete: if isValidId(noteId)
        && resource != null
        && isAuthorizedStudent(existing().uid, existing().studentId);
    }

    // Collection: /leaveRecords/{recordId}
    match /leaveRecords/{recordId} {
      allow get: if isValidId(recordId)
        && resource != null
        && isAuthorizedStudent(existing().uid, existing().studentId);
      allow list: if isAuthorizedStudent(existing().uid, existing().studentId);
      allow create: if isValidId(recordId)
        && isValidLeaveRecord(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(recordId)
        && resource != null
        && isAuthorizedStudent(existing().uid, existing().studentId);
    }

    // Collection: /digitalKitabs/{kitabId}
    match /digitalKitabs/{kitabId} {
      allow get: if isValidId(kitabId)
        && resource != null
        && isAuthorizedStudent(existing().uid, existing().studentId);
      allow list: if isAuthorizedStudent(existing().uid, existing().studentId);
      allow create: if isValidId(kitabId)
        && isValidDigitalKitab(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(kitabId)
        && resource != null
        && isValidDigitalKitab(incoming())
        && isAuthorizedStudent(existing().uid, existing().studentId)
        && incoming().uid == existing().uid
        && incoming().studentId == existing().studentId
        && incoming().storagePath == existing().storagePath
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'arabicTitle', 'author', 'category', 'classBatch', 'language', 'pages', 'pdfUrl', 'summary']);
      allow delete: if isValidId(kitabId)
        && resource != null
        && isAuthorizedStudent(existing().uid, existing().studentId);
    }

    // Collection: /campusChatMessages/{messageId}
    match /campusChatMessages/{messageId} {
      allow get: if isValidId(messageId)
        && resource != null
        && existing().campusId == 'ics-academy'
        && isPortalActorId(existing().senderId);
      allow list: if existing().createdAtMs > 0;
      allow create: if isValidId(messageId)
        && isValidChatMessage(incoming())
        && incoming().id == messageId
        && incoming().createdAt == request.time;
      allow update: if isValidId(messageId)
        && resource != null
        && isValidChatMessage(incoming())
        && incoming().id == existing().id
        && incoming().campusId == existing().campusId
        && incoming().roomId == existing().roomId
        && incoming().senderId == existing().senderId
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtMs == existing().createdAtMs
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['deliveredTo', 'readBy', 'deliveredAtMap', 'readAtMap'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['pollMeta'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['starredBy'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['deletedFor'])
          || (!existing().isDeleted && incoming().isDeleted == true && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletedBy', 'deletedById', 'text', 'mediaType', 'mediaUrl']))
        );
      allow delete: if false;
    }

    // Collection: /campusChatMeta/{roomDocId}
    match /campusChatMeta/{roomDocId} {
      allow get: if isValidId(roomDocId)
        && resource != null
        && existing().campusId == 'ics-academy'
        && isPortalActorId(existing().updatedByActorId);
      allow list: if existing().campusId == 'ics-academy';
      allow create: if isValidId(roomDocId)
        && isValidChatRoomMeta(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(roomDocId)
        && resource != null
        && isValidChatRoomMeta(incoming())
        && incoming().campusId == existing().campusId
        && incoming().roomId == existing().roomId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['onlyAdminsCanPost', 'pinnedMessageId', 'updatedByActorId', 'updatedAtMs']);
      allow delete: if false;
    }

    // Collection: /campusChatPresence/{actorId}
    match /campusChatPresence/{actorId} {
      allow get: if isValidId(actorId)
        && resource != null
        && existing().campusId == 'ics-academy'
        && isPortalActorId(existing().actorId);
      allow list: if existing().campusId == 'ics-academy';
      allow create: if isValidId(actorId)
        && isValidChatPresence(incoming())
        && incoming().actorId == actorId
        && incoming().createdAt == request.time;
      allow update: if isValidId(actorId)
        && resource != null
        && isValidChatPresence(incoming())
        && incoming().campusId == existing().campusId
        && incoming().actorId == existing().actorId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['actorName', 'actorRole', 'lastSeenMs', 'isOnline', 'hideOnline', 'typingRoomId', 'typingMode', 'typingUpdatedAtMs']);
      allow delete: if false;
    }

    // Validation Blueprint: CampusAcademicRecord
    function isValidCampusAcademicRecord(data) {
      return data.keys().hasAll([
          'id',
          'campusId',
          'recordKind',
          'className',
          'actorId',
          'actorName',
          'status',
          'isDeleted',
          'createdAt',
          'updatedAtMs'
        ])
        && data.keys().hasOnly([
          'id',
          'campusId',
          'recordKind',
          'className',
          'actorId',
          'actorName',
          'status',
          'isDeleted',
          'studentId',
          'studentName',
          'admissionNo',
          'month',
          'title',
          'subjectOrCategory',
          'description',
          'remarks',
          'dateString',
          'receiptNo',
          'photoUrl',
          'totalMarks',
          'obtainedMarks',
          'fixedAmount',
          'paidAmount',
          'acknowledged',
          'questions',
          'answers',
          'questionMarks',
          'createdAt',
          'updatedAtMs'
        ])
        && isValidId(data.id)
        && data.campusId == 'ics-academy'
        && data.recordKind is string
        && (
          data.recordKind == 'unit_test'
          || data.recordKind == 'test_submission'
          || data.recordKind == 'holiday_log'
          || data.recordKind == 'discipline_note'
          || data.recordKind == 'zadul_khair'
          || data.recordKind == 'monthly_syllabus'
        )
        && data.className is string
        && data.className.size() >= 1
        && data.className.size() <= 40
        && isPortalActorId(data.actorId)
        && data.actorName is string
        && data.actorName.size() >= 1
        && data.actorName.size() <= 120
        && data.status is string
        && (
          data.status == 'active'
          || data.status == 'submitted'
          || data.status == 'graded'
          || data.status == 'pending'
          || data.status == 'verified'
          || data.status == 'advisory'
          || data.status == 'warning'
          || data.status == 'serious'
          || data.status == 'paid'
          || data.status == 'partial'
          || data.status == 'unpaid'
          || data.status == 'deleted'
        )
        && data.isDeleted is bool
        && (!('studentId' in data) || isPortalActorId(data.studentId))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 120))
        && (!('admissionNo' in data) || (data.admissionNo is string && data.admissionNo.size() <= 40))
        && (!('month' in data) || (data.month is string && data.month.size() <= 40))
        && (!('title' in data) || (data.title is string && data.title.size() <= 240))
        && (!('subjectOrCategory' in data) || (data.subjectOrCategory is string && data.subjectOrCategory.size() <= 120))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 2000))
        && (!('dateString' in data) || (data.dateString is string && data.dateString.size() <= 40))
        && (!('receiptNo' in data) || (data.receiptNo is string && data.receiptNo.size() <= 60))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 700000))
        && (!('totalMarks' in data) || (data.totalMarks is number && data.totalMarks >= 0 && data.totalMarks <= 1000))
        && (!('obtainedMarks' in data) || (data.obtainedMarks is number && data.obtainedMarks >= 0 && data.obtainedMarks <= 1000))
        && (!('fixedAmount' in data) || (data.fixedAmount is number && data.fixedAmount >= 0 && data.fixedAmount <= 1000000))
        && (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 1000000))
        && (!('acknowledged' in data) || data.acknowledged is bool)
        && (!('questions' in data) || (data.questions is list && data.questions.size() <= 50 && (data.questions.size() == 0 || data.questions[0] is map)))
        && (!('answers' in data) || (data.answers is map && data.answers.size() <= 50))
        && (!('questionMarks' in data) || (data.questionMarks is map && data.questionMarks.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAtMs is int
        && data.updatedAtMs > 0;
    }

    // Collection: /campusNotifications/{notifId}
    match /campusNotifications/{notifId} {
      allow get: if isValidId(notifId)
        && resource != null
        && existing().campusId == 'ics-academy'
        && existing().createdAtMs is int;
      allow list: if existing().createdAtMs > 0;
      allow create: if isValidId(notifId)
        && isValidCampusNotification(incoming())
        && incoming().id == notifId
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Collection: /campusAcademicRecords/{recordId}
    match /campusAcademicRecords/{recordId} {
      allow get: if isValidId(recordId)
        && resource != null
        && existing().campusId == 'ics-academy'
        && existing().updatedAtMs > 0;
      allow list: if existing().updatedAtMs > 0;
      allow create: if isValidId(recordId)
        && isValidCampusAcademicRecord(incoming())
        && incoming().id == recordId
        && incoming().createdAt == request.time;
      allow update: if isValidId(recordId)
        && resource != null
        && isValidCampusAcademicRecord(incoming())
        && incoming().id == existing().id
        && incoming().campusId == existing().campusId
        && incoming().recordKind == existing().recordKind
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'className',
          'actorId',
          'actorName',
          'status',
          'isDeleted',
          'studentId',
          'studentName',
          'admissionNo',
          'month',
          'title',
          'subjectOrCategory',
          'description',
          'remarks',
          'dateString',
          'receiptNo',
          'photoUrl',
          'totalMarks',
          'obtainedMarks',
          'fixedAmount',
          'paidAmount',
          'acknowledged',
          'questions',
          'answers',
          'questionMarks',
          'updatedAtMs'
        ]);
      allow delete: if false;
    }

    // Validation Blueprint: CampusCall
    function isValidCampusCall(data) {
      return data.keys().hasAll([
          'id',
          'campusId',
          'roomId',
          'callType',
          'callerId',
          'callerName',
          'callerRole',
          'calleeId',
          'calleeName',
          'calleeRole',
          'status',
          'offerSdp',
          'callerCandidates',
          'calleeCandidates',
          'startedAtMs',
          'createdAt',
          'updatedAtMs'
        ])
        && data.keys().hasOnly([
          'id',
          'campusId',
          'roomId',
          'callType',
          'callerId',
          'callerName',
          'callerRole',
          'callerSubtitle',
          'calleeId',
          'calleeName',
          'calleeRole',
          'calleeSubtitle',
          'status',
          'offerSdp',
          'answerSdp',
          'callerCandidates',
          'calleeCandidates',
          'startedAtMs',
          'connectedAtMs',
          'endedAtMs',
          'durationSec',
          'createdAt',
          'updatedAtMs'
        ])
        && isValidId(data.id)
        && data.campusId == 'ics-academy'
        && data.roomId is string
        && data.roomId.size() >= 3
        && data.roomId.size() <= 160
        && data.callType is string
        && (data.callType == 'voice' || data.callType == 'video')
        && isPortalActorId(data.callerId)
        && data.callerName is string
        && data.callerName.size() >= 1
        && data.callerName.size() <= 120
        && data.callerRole is string
        && (data.callerRole == 'student' || data.callerRole == 'usthad' || data.callerRole == 'principal')
        && (!('callerSubtitle' in data) || (data.callerSubtitle is string && data.callerSubtitle.size() <= 120))
        && isPortalActorId(data.calleeId)
        && data.callerId != data.calleeId
        && data.calleeName is string
        && data.calleeName.size() >= 1
        && data.calleeName.size() <= 120
        && data.calleeRole is string
        && (data.calleeRole == 'student' || data.calleeRole == 'usthad' || data.calleeRole == 'principal')
        && (!('calleeSubtitle' in data) || (data.calleeSubtitle is string && data.calleeSubtitle.size() <= 120))
        && data.status is string
        && (
          data.status == 'ringing'
          || data.status == 'accepted'
          || data.status == 'connected'
          || data.status == 'declined'
          || data.status == 'missed'
          || data.status == 'ended'
          || data.status == 'busy'
        )
        && data.offerSdp is string
        && data.offerSdp.size() <= 24000
        && (!('answerSdp' in data) || (data.answerSdp is string && data.answerSdp.size() <= 24000))
        && data.callerCandidates is list
        && data.callerCandidates.size() <= 60
        && (data.callerCandidates.size() == 0 || data.callerCandidates[0] is string)
        && data.calleeCandidates is list
        && data.calleeCandidates.size() <= 60
        && (data.calleeCandidates.size() == 0 || data.calleeCandidates[0] is string)
        && data.startedAtMs is int
        && data.startedAtMs > 0
        && (!('connectedAtMs' in data) || (data.connectedAtMs is int && data.connectedAtMs >= 0))
        && (!('endedAtMs' in data) || (data.endedAtMs is int && data.endedAtMs >= 0))
        && (!('durationSec' in data) || (data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 86400))
        && data.createdAt is timestamp
        && data.updatedAtMs is int
        && data.updatedAtMs > 0;
    }

    // Collection: /campusCalls/{callId}
    match /campusCalls/{callId} {
      allow get: if isValidId(callId)
        && resource != null
        && existing().campusId == 'ics-academy'
        && isPortalActorId(existing().callerId)
        && isPortalActorId(existing().calleeId);
      allow list: if existing().campusId == 'ics-academy';
      allow create: if isValidId(callId)
        && isValidCampusCall(incoming())
        && incoming().id == callId
        && incoming().status == 'ringing'
        && incoming().createdAt == request.time;
      allow update: if isValidId(callId)
        && resource != null
        && isValidCampusCall(incoming())
        && incoming().id == existing().id
        && incoming().campusId == existing().campusId
        && incoming().roomId == existing().roomId
        && incoming().callType == existing().callType
        && incoming().callerId == existing().callerId
        && incoming().calleeId == existing().calleeId
        && incoming().offerSdp == existing().offerSdp
        && incoming().startedAtMs == existing().startedAtMs
        && incoming().createdAt == existing().createdAt
        && !(existing().status in ['declined', 'missed', 'ended', 'busy'])
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['callerCandidates', 'updatedAtMs'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['calleeCandidates', 'updatedAtMs'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'answerSdp', 'calleeCandidates', 'connectedAtMs', 'updatedAtMs'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'connectedAtMs', 'updatedAtMs'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAtMs', 'durationSec', 'updatedAtMs'])
        );
      allow delete: if false;
    }
  }
}
