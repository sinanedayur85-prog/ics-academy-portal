{
  "installCommand": "sed -i '/eslint-plugin-security-rules/d' package.json && npm i --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=*, camera=*, autoplay=*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai/:action",
      "destination": "/api/ai/[action]?action=:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
