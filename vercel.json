{
  "installCommand": "sed -i '/eslint-plugin-security-rules/d' package.json && npm i --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=*, camera=*, autoplay=*"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai/chat.js"
    },
    {
      "source": "/api/ai/transcribe",
      "destination": "/api/ai/transcribe.js"
    },
    {
      "source": "/api/ai/study-assistant",
      "destination": "/api/ai/study-assistant.js"
    },
    {
      "source": "/api/app/version",
      "destination": "/api/app/version.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ais-pre-rhfqjrwneaewkmnanoof2j-896319436298.asia-east1.run.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
