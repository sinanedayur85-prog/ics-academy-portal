{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/image": [
        "./shims/next-image.tsx"
      ],
      "next/link": [
        "./shims/next-link.tsx"
      ]
    },
    "noEmit": true
  },
  "exclude": ["dist", "api", "public/assets/aistudio"]
}
