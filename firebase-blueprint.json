    },
    "/campusChatPresence/{actorId}": {
      "schema": { "$ref": "#/entities/CampusChatPresence" },
      "description": "Stores real-time online heartbeat, last seen, and typing indicator for each portal actor."
    },
    "/campusNotifications/{notifId}": {
      "schema": { "$ref": "#/entities/CampusNotification" },
      "description": "Stores real-time targeted campus announcements, chat alerts, attendance updates, and leave notifications."
    },
    "/campusAcademicRecords/{recordId}": {
      "schema": { "$ref": "#/entities/CampusAcademicRecord" },
      "description": "Stores real-time Monthly/Unit Tests, Student Submissions, Holiday Academic & SSF Da'wa Logs, Private Discipline Notes, and Zadul Khair Monthly Contribution Records."
    },
    "/campusCalls/{callId}": {
      "schema": { "$ref": "#/entities/CampusCall" },
      "description": "Stores real-time 1-on-1 WebRTC voice and video call signaling documents and call history records."
    }
  }
}
