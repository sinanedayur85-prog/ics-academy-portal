# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Web Push (VAPID) keys for real-time Android & iOS Home Screen background push notifications.
# Optional in preview (auto-generated in memory if omitted); set in Secrets for persistent production push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@icsacademy.edu"

# Firebase Cloud Messaging (FCM) project ID for instant closed-app Android APK push notifications (uses ADC/IAM).
FCM_PROJECT_ID="ics-academy-push"

